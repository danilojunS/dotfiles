# SSH agent. Must stay ABOVE the p10k instant prompt block: this may prompt for
# a key passphrase, and instant prompt swallows console input.
#
# A GUI macOS session already has the Keychain-backed launchd agent, and a
# forwarded agent sets SSH_AUTH_SOCK too, so in both cases there is nothing to
# do. An incoming SSH session gets neither (the launchd agent is Aqua-only),
# which is where keychain comes in: it starts one persistent agent per host and
# re-exports it to every later shell, so the passphrase is entered once per boot
# rather than on every signed commit.
if [[ -z "$SSH_AUTH_SOCK" ]] && command -v keychain >/dev/null 2>&1; then
  if keychain add --help >/dev/null 2>&1; then
    # --quick short-circuits once the agent holds a key, so only the first shell
    # after a boot pays for the lock and the prompt. --immediate skips the
    # "Press Enter to initialize keys" interstitial and asks straight away.
    _kc=(keychain add --eval --quiet --quick --immediate --ignore-missing --no-gui)  # 3.x
  else
    _kc=(keychain --eval --quiet)                                        # 2.x
  fi
  # Without a tty there is nowhere to type a passphrase, so only adopt an agent
  # that is already running instead of blocking a non-interactive shell.
  [[ -t 0 ]] || _kc+=(--noask)
  # stderr must NOT be redirected here: the passphrase prompt goes to stderr,
  # and hiding it leaves the shell blocked on invisible input.
  eval "$("${_kc[@]}" id_ed25519)"
  unset _kc
fi

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

[[ -f "/opt/homebrew/share/powerlevel10k/powerlevel10k.zsh-theme" ]] && source "/opt/homebrew/share/powerlevel10k/powerlevel10k.zsh-theme"
[[ -f "/usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme" ]] && source "/usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme"
[[ -f "/usr/local/share/powerlevel10k/powerlevel10k.zsh-theme" ]] && source "/usr/local/share/powerlevel10k/powerlevel10k.zsh-theme"

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# import packages and tools

# remember ssh git passhphrase
# echo "AddKeysToAgent yes" >> ~/.ssh/config
# eval $(ssh-agent) > /dev/null

## ALIASES

export PATH="$HOME/bin:$HOME/.local/bin/:$PATH"

source $HOME/.dotfiles/shell/dj.sh
source "$HOME/.customrc"

# LM Studio CLI (lms), only if installed on this machine
if [ -d "$HOME/.lmstudio/bin" ]; then
  export PATH="$PATH:$HOME/.lmstudio/bin"
fi
